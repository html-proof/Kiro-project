rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ============================================================================
    // CLEAN STRUCTURE: users/{userId}/
    // Each user has unique data - no conflicts possible
    // ============================================================================
    
    match /users/{userId} {
      // Profile document (email, name, languages, moods, created_at)
      match /profile/data {
        allow read, write: if isOwner(userId);
      }
      
      // Playback document (current_playing, previous_played, next_recommended)
      match /playback/state {
        allow read, write: if isOwner(userId);
      }
      
      // History subcollection - {songId} with timestamp
      match /history/{songId} {
        allow read, write: if isOwner(userId);
      }
      
      // Searches subcollection - {searchId} with timestamp
      match /searches/{searchId} {
        allow read, write: if isOwner(userId);
      }
      
      // Likes subcollection - {songId} liked songs
      match /likes/{songId} {
        allow read, write: if isOwner(userId);
      }
      
      // Allow any other subcollections (for future expansion)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================================================
    // LEGACY SUPPORT (for backward compatibility during migration)
    // ============================================================================
    
    match /user_data/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    match /likes/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
