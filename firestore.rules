rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ============================================================================
    // ORGANIZED STRUCTURE: users/{userId}/...
    // ============================================================================
    
    match /users/{userId} {
      // Allow user to read/write their own root document
      allow read, write: if isOwner(userId);
      
      // Profile subcollection
      match /profile/{document} {
        allow read, write: if isOwner(userId);
      }
      
      // Preferences subcollection
      match /preferences/{document} {
        allow read, write: if isOwner(userId);
      }
      
      // Playback state subcollection
      match /playback/{document} {
        allow read, write: if isOwner(userId);
      }
      
      // Play history subcollection
      match /history/{songId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // Search history subcollection
      match /searches/{searchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // Likes subcollection
      match /likes/{songId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // Playlists subcollection
      match /playlists/{playlistId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
        
        // Playlist songs subcollection
        match /songs/{songId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId);
          allow update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }
      
      // Recommendations subcollection
      match /recommendations/{recommendationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // Allow all other subcollections under user
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================================================
    // LEGACY SUPPORT (for backward compatibility)
    // ============================================================================
    
    // Old user_data structure
    match /user_data/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Old likes structure
    match /likes/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
